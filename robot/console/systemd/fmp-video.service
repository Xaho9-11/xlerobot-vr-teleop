[Unit]
Description=FMP video daemon (cameras, picture-in-picture, WebRTC :8443)
After=network-online.target

[Service]
ExecStart=/bin/bash %h/fmp_scripts/video_daemon.sh
Restart=on-failure
RestartSec=5
StandardOutput=append:%h/fmp_logs/video_daemon.log
StandardError=append:%h/fmp_logs/video_daemon.log

[Install]
WantedBy=default.target

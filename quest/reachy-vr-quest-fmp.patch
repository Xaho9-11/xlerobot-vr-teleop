diff --git a/Assets/Scripts/Runtime/Reachy/FmpAutoConnect.cs b/Assets/Scripts/Runtime/Reachy/FmpAutoConnect.cs
new file mode 100644
index 0000000..4b26811
--- /dev/null
+++ b/Assets/Scripts/Runtime/Reachy/FmpAutoConnect.cs
@@ -0,0 +1,138 @@
+// FMP (2026-11-13): connect pose and video automatically, so the headset needs no menu clicks.
+// On start (after a short delay for the scene to settle) both "connect" toggles are switched on with the saved
+// Robot IP; while a toggle stays on, a dropped connection is retried every few seconds. Switching a toggle off in
+// the headset is respected (no retry until it is switched on again). The Robot IP itself is set from the PC
+// (quest.ps1 ip lab|home edits the saved PlayerPrefs of this debuggable build).
+// Self-installing: created after the scene loads, so the scene file stays untouched.
+using System.Collections;
+using ReachyMiniTeleop.Transport;
+using ReachyMiniTeleop.UI;
+using UnityEngine;
+
+namespace ReachyMiniTeleop.Reachy
+{
+    public sealed class FmpAutoConnect : MonoBehaviour
+    {
+        public float startDelay = 2f;
+        public float retryInterval = 3f;
+        // Menu panel (2026-11-13, user: the Robot IP window could not be hidden and blocked the view): hidden once
+        // pose and video are both up; the LEFT controller's menu button (≡) shows / hides it (X/A record the
+        // neutral grip, B records, Y opens the system menu); shown again when the links have been down this long.
+        public float showMenuAfterDownSeconds = 10f;
+
+        private ReachyDaemonTargetWebSocketClient _daemon;
+        private WebRTCClient _rtc;
+        private CanvasGroup _menu;
+        private bool _menuShown = true, _manual, _lastUp;
+        private float _upSince = -1f, _downSince;
+
+        [RuntimeInitializeOnLoadMethod(RuntimeInitializeLoadType.AfterSceneLoad)]
+        private static void Install()
+        {
+            if (FindFirstObjectByType<FmpAutoConnect>() != null)
+                return;
+            var go = new GameObject("FmpAutoConnect");
+            DontDestroyOnLoad(go);
+            go.AddComponent<FmpAutoConnect>();
+        }
+
+        private IEnumerator Start()
+        {
+            yield return new WaitForSeconds(startDelay);
+            string ip = PlayerPrefs.GetString(ReachyEndpointInputController.PlayerPrefsKey, "");
+            if (string.IsNullOrWhiteSpace(ip))
+            {
+                Debug.Log("[FmpAutoConnect] no saved Robot IP; waiting for manual connect");
+                yield break;
+            }
+
+            var pose = FindFirstObjectByType<ReachyEndpointInputController>();
+            var video = FindFirstObjectByType<ReachyVideoInputController>();
+            var daemon = _daemon = FindFirstObjectByType<ReachyDaemonTargetWebSocketClient>();
+            var rtc = _rtc = FindFirstObjectByType<WebRTCClient>();
+            var follow = FindFirstObjectByType<HeadFollowMenu>();  // the head-following menu with the IP fields
+            if (follow != null)  // hide by fading the canvas; its scripts keep running (connect paths stay usable)
+                _menu = follow.GetComponent<CanvasGroup>() ?? follow.gameObject.AddComponent<CanvasGroup>();
+            _downSince = Time.unscaledTime;
+            Debug.Log($"[FmpAutoConnect] ip={ip} pose={(pose != null)} video={(video != null)} daemon={(daemon != null)} rtc={(rtc != null)}");
+
+            // The Reachy Mini "wake" call is an http:// request to the original daemon's REST API; our robot core
+            // has no such API, and this build blocks plain http, so the call threw and aborted the pose connect.
+            if (daemon != null)
+                daemon.autoWakeOnStart = false;
+            // both connect paths read the IP from their input fields; fill them from the saved value (the video
+            // field otherwise keeps the scene default)
+            if (pose != null && pose.robotIpInput != null)
+                pose.robotIpInput.SetTextWithoutNotify(ip);
+            if (video != null && video.robotIpInput != null)
+                video.robotIpInput.SetTextWithoutNotify(ip);
+
+            // the user's intent: on at start; a click on a toggle in the headset changes it. (The video toggle also
+            // follows the link state without notifying - a drop turns it off - so the toggle itself is not the intent.)
+            bool wantPose = true, wantVideo = true;
+            if (pose != null && pose.connectPoseToggle != null)
+                pose.connectPoseToggle.onValueChanged.AddListener(v => wantPose = v);
+            if (video != null && video.connectVideoToggle != null)
+                video.connectVideoToggle.onValueChanged.AddListener(v => wantVideo = v);
+
+            // switching the toggles on runs the app's own connect path (same as a click in the headset)
+            if (pose != null && pose.connectPoseToggle != null && !pose.connectPoseToggle.isOn)
+                pose.connectPoseToggle.isOn = true;
+            if (video != null && video.connectVideoToggle != null && !video.connectVideoToggle.isOn)
+                video.connectVideoToggle.isOn = true;
+            wantPose = wantVideo = true;
+
+            var wait = new WaitForSeconds(retryInterval);
+            while (true)
+            {
+                yield return wait;
+                if (wantPose && pose != null && daemon != null && !daemon.IsConnectedOrConnecting)
+                {
+                    Debug.Log("[FmpAutoConnect] pose link down, reconnecting");
+                    pose.TryConnectFromCurrentInput();
+                }
+
+                if (wantVideo && video != null && rtc != null && !rtc.IsConnectedOrConnecting)
+                {
+                    Debug.Log("[FmpAutoConnect] video link down, reconnecting");
+                    video.TryConnectFromCurrentInput();
+                }
+            }
+        }
+
+        private void Update()
+        {
+            if (_menu == null)
+                return;
+            if (OVRInput.GetDown(OVRInput.Button.Start))  // left controller menu button
+            {
+                SetMenu(!_menuShown);
+                _manual = true;  // the user decides until the link state changes
+            }
+
+            bool up = _daemon != null && _daemon.IsRunning && _rtc != null && _rtc.IsConnectedOrConnecting;
+            float now = Time.unscaledTime;
+            if (up != _lastUp)
+            {
+                _lastUp = up;
+                _manual = false;
+                if (up) _upSince = now; else _downSince = now;
+            }
+            if (_manual)
+                return;
+            if (up && _menuShown && now - _upSince > 1.5f)
+                SetMenu(false);
+            else if (!up && !_menuShown && now - _downSince > showMenuAfterDownSeconds)
+                SetMenu(true);
+        }
+
+        private void SetMenu(bool show)
+        {
+            _menuShown = show;
+            _menu.alpha = show ? 1f : 0f;
+            _menu.interactable = show;
+            _menu.blocksRaycasts = show;
+            Debug.Log($"[FmpAutoConnect] menu {(show ? "shown" : "hidden")}");
+        }
+    }
+}
diff --git a/Assets/Scripts/Runtime/Reachy/FmpXrInput.cs b/Assets/Scripts/Runtime/Reachy/FmpXrInput.cs
new file mode 100644
index 0000000..f06330d
--- /dev/null
+++ b/Assets/Scripts/Runtime/Reachy/FmpXrInput.cs
@@ -0,0 +1,88 @@
+// FMP addition (2026-10-20, not part of upstream reachy-vr-quest): controller state for XLeRobot arm teleop.
+// Sent as "fmp_controllers" inside the FullBodyTarget JSON each frame. Poses are raw Unity XR tracking-space
+// values (left-handed: x right, y up, z forward; metres; quaternion x,y,z,w) for the head and both controllers,
+// so the robot side can express hand motion relative to where the operator is facing.
+using Newtonsoft.Json;
+using UnityEngine;
+using UnityEngine.XR;
+
+namespace ReachyMiniTeleop.Reachy
+{
+    [System.Serializable]
+    public sealed class FmpXrPose
+    {
+        [JsonProperty("tracked")] public bool tracked;
+        [JsonProperty("pos")] public float[] pos;
+        [JsonProperty("rot")] public float[] rot;
+    }
+
+    [System.Serializable]
+    public sealed class FmpXrController
+    {
+        [JsonProperty("tracked")] public bool tracked;
+        [JsonProperty("pos")] public float[] pos;
+        [JsonProperty("rot")] public float[] rot;
+        [JsonProperty("trigger")] public float trigger;
+        [JsonProperty("grip")] public float grip;
+        [JsonProperty("primary")] public bool primary;      // A / X
+        [JsonProperty("secondary")] public bool secondary;  // B / Y
+        [JsonProperty("stick")] public float[] stick;       // thumbstick x, y
+        [JsonProperty("stick_click")] public bool stickClick;
+    }
+
+    [System.Serializable]
+    public sealed class FmpXrState
+    {
+        [JsonProperty("head")] public FmpXrPose head;
+        [JsonProperty("left")] public FmpXrController left;
+        [JsonProperty("right")] public FmpXrController right;
+    }
+
+    public static class FmpXrInput
+    {
+        public static FmpXrState Read()
+        {
+            return new FmpXrState
+            {
+                head = ReadPose(XRNode.CenterEye),
+                left = ReadController(XRNode.LeftHand),
+                right = ReadController(XRNode.RightHand),
+            };
+        }
+
+        private static FmpXrPose ReadPose(XRNode node)
+        {
+            var d = InputDevices.GetDeviceAtXRNode(node);
+            var p = new FmpXrPose();
+            if (!d.isValid)
+                return p;
+            d.TryGetFeatureValue(CommonUsages.isTracked, out p.tracked);
+            if (d.TryGetFeatureValue(CommonUsages.devicePosition, out Vector3 pos))
+                p.pos = new[] { pos.x, pos.y, pos.z };
+            if (d.TryGetFeatureValue(CommonUsages.deviceRotation, out Quaternion rot))
+                p.rot = new[] { rot.x, rot.y, rot.z, rot.w };
+            return p;
+        }
+
+        private static FmpXrController ReadController(XRNode node)
+        {
+            var d = InputDevices.GetDeviceAtXRNode(node);
+            var c = new FmpXrController();
+            if (!d.isValid)
+                return c;
+            d.TryGetFeatureValue(CommonUsages.isTracked, out c.tracked);
+            if (d.TryGetFeatureValue(CommonUsages.devicePosition, out Vector3 pos))
+                c.pos = new[] { pos.x, pos.y, pos.z };
+            if (d.TryGetFeatureValue(CommonUsages.deviceRotation, out Quaternion rot))
+                c.rot = new[] { rot.x, rot.y, rot.z, rot.w };
+            d.TryGetFeatureValue(CommonUsages.trigger, out c.trigger);
+            d.TryGetFeatureValue(CommonUsages.grip, out c.grip);
+            d.TryGetFeatureValue(CommonUsages.primaryButton, out c.primary);
+            d.TryGetFeatureValue(CommonUsages.secondaryButton, out c.secondary);
+            if (d.TryGetFeatureValue(CommonUsages.primary2DAxis, out Vector2 stick))
+                c.stick = new[] { stick.x, stick.y };
+            d.TryGetFeatureValue(CommonUsages.primary2DAxisClick, out c.stickClick);
+            return c;
+        }
+    }
+}

diff --git a/Assets/FmpTools/Editor/FmpBatch.cs b/Assets/FmpTools/Editor/FmpBatch.cs
new file mode 100644
index 0000000..727163b
--- /dev/null
+++ b/Assets/FmpTools/Editor/FmpBatch.cs
@@ -0,0 +1,42 @@
+// FMP local helper (not part of upstream reachy-vr-quest): batchmode entry points.
+// Lives in its own editor assembly so it compiles even while Assembly-CSharp is missing NuGet DLLs.
+//   Unity.exe -batchmode -nographics -ignorecompilererrors -projectPath <p> -executeMethod FmpTools.FmpBatch.RestoreNuget -quit
+//   Unity.exe -batchmode -nographics -projectPath <p> -buildTarget Android -executeMethod FmpTools.FmpBatch.BuildAndroid -quit
+using System.IO;
+using System.Linq;
+using UnityEditor;
+using UnityEditor.Build.Reporting;
+using UnityEngine;
+
+namespace FmpTools
+{
+    public static class FmpBatch
+    {
+        public static void RestoreNuget()
+        {
+            Debug.Log("[FmpBatch] NuGet restore start");
+            NugetForUnity.PackageRestorer.Restore(false);
+            AssetDatabase.Refresh();
+            Debug.Log("[FmpBatch] NuGet restore done");
+        }
+
+        public static void BuildAndroid()
+        {
+            var scenes = EditorBuildSettings.scenes.Where(s => s.enabled).Select(s => s.path).ToArray();
+            Directory.CreateDirectory("Builds");
+            var options = new BuildPlayerOptions
+            {
+                scenes = scenes,
+                locationPathName = "Builds/ReachyMiniTeleop-fmp.apk",
+                target = BuildTarget.Android,
+                options = BuildOptions.Development,
+            };
+            Debug.Log("[FmpBatch] Building scenes: " + string.Join(", ", scenes));
+            BuildReport report = BuildPipeline.BuildPlayer(options);
+            Debug.Log($"[FmpBatch] Build result: {report.summary.result}, size {report.summary.totalSize} bytes, " +
+                      $"errors {report.summary.totalErrors}, time {report.summary.totalTime}");
+            if (Application.isBatchMode)
+                EditorApplication.Exit(report.summary.result == BuildResult.Succeeded ? 0 : 1);
+        }
+    }
+}
